rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidLeaderboardEntry(data) {
      return data.keys().hasAll([
        'uid',
        'playerName',
        'cafeName',
        'score',
        'balance',
        'reputation',
        'businessRating',
        'stage',
        'pcCount',
        'day',
        'totalCustomersServed',
        'createdAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'uid',
        'playerName',
        'cafeName',
        'score',
        'balance',
        'reputation',
        'businessRating',
        'stage',
        'pcCount',
        'day',
        'totalCustomersServed',
        'createdAt',
        'updatedAt'
      ]) &&
      isValidId(data.uid) &&
      data.uid == request.auth.uid &&
      data.playerName is string && data.playerName.size() >= 1 && data.playerName.size() <= 40 &&
      data.cafeName is string && data.cafeName.size() >= 1 && data.cafeName.size() <= 40 &&
      data.score is number && data.score >= 0 && data.score <= 1000000000000 &&
      data.balance is number && data.balance >= -2000000 && data.balance <= 1000000000000 &&
      data.reputation is number && data.reputation >= 0 && data.reputation <= 5 &&
      data.businessRating is number && data.businessRating >= 0 && data.businessRating <= 100 &&
      data.stage is number && data.stage >= 1 && data.stage <= 5 &&
      data.pcCount is number && data.pcCount >= 0 && data.pcCount <= 500 &&
      data.day is number && data.day >= 1 && data.day <= 100000 &&
      data.totalCustomersServed is number && data.totalCustomersServed >= 0 && data.totalCustomersServed <= 100000000 &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'displayName', 'cafeName', 'createdAt', 'updatedAt']) &&
      data.keys().hasOnly(['uid', 'displayName', 'cafeName', 'createdAt', 'updatedAt']) &&
      isValidId(data.uid) &&
      data.uid == request.auth.uid &&
      data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 40 &&
      data.cafeName is string && data.cafeName.size() >= 1 && data.cafeName.size() <= 40 &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    match /leaderboard/{entryId} {
      allow get: if isSignedIn() && isValidId(entryId);
      allow list: if isSignedIn() && existing().score >= 0;
      allow create: if isVerifiedUser() &&
        isValidId(entryId) &&
        isOwner(entryId) &&
        isValidLeaderboardEntry(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isVerifiedUser() &&
        isValidId(entryId) &&
        isOwner(entryId) &&
        isValidLeaderboardEntry(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'playerName',
          'cafeName',
          'score',
          'balance',
          'reputation',
          'businessRating',
          'stage',
          'pcCount',
          'day',
          'totalCustomersServed',
          'updatedAt'
        ]);
      allow delete: if isVerifiedUser() && isValidId(entryId) && isOwner(entryId);
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isVerifiedUser() &&
        isValidId(userId) &&
        isOwner(userId) &&
        isValidUserProfile(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isVerifiedUser() &&
        isValidId(userId) &&
        isOwner(userId) &&
        isValidUserProfile(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName',
          'cafeName',
          'updatedAt'
        ]);
      allow delete: if false;
    }
  }
}
