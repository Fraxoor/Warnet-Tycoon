# ==========================================
# Warnet Tycoon — Environment Configuration
# ==========================================
# NOTE: Do NOT commit real API keys or secrets to version control.
# Copy this file to '.env.local' for local development.
# In production / CI/CD, these values are injected from GitHub Secrets.

# --- AI Studio / Gemini API ---
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
APP_URL="https://fraxoor.github.io/Warnet-Tycoon"

# --- Firebase Client Configuration ---
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY"
VITE_FIREBASE_PROJECT_ID="YOUR_FIREBASE_PROJECT_ID"
VITE_FIREBASE_APP_ID="YOUR_FIREBASE_APP_ID"
VITE_FIREBASE_AUTH_DOMAIN="YOUR_FIREBASE_AUTH_DOMAIN"
VITE_FIREBASE_DATABASE_ID="(default)"
VITE_FIREBASE_STORAGE_BUCKET="YOUR_FIREBASE_STORAGE_BUCKET"
VITE_FIREBASE_MESSAGING_SENDER_ID="YOUR_FIREBASE_MESSAGING_SENDER_ID"
VITE_FIREBASE_OAUTH_CLIENT_ID="YOUR_FIREBASE_OAUTH_CLIENT_ID"
