# ==========================================
# Warnet Tycoon — Environment Configuration
# ==========================================
# NOTE: Do NOT commit real API keys or secrets to version control.
# Copy this file to '.env.local' for local development.
# In production / CI/CD, these values are injected from GitHub Secrets.

# --- Supabase (required for auth, leaderboard, cloud saves) ---
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="sb_publishable_..."

# --- AI Studio / Gemini API (optional) ---
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
APP_URL="https://fraxoor.github.io/Warnet-Tycoon"
